{
  // Number popups for the price shown on picking up currency (QolPrices.cs): copies of the Breach splinter popup that
  // show the game's own Chaos Orb and Divine Orb pictures, shrunk to the popup's icon size. The setting prices.popupIcon
  // "gold" uses the game's gold coin popup instead (no rows needed for that).
  "rows": [
    { "table": "WorldPopupIconTypes", "copyOf": { "Id": "BreachSplinter" },
      "set": { "Id": "LocalExileChaosPopup", "__col1": "Art/2DArt/UIImages/InGame/LocalExileChaosOrbPopup", "__col8": "Chaos" } },
    { "table": "WorldPopupIconTypes", "copyOf": { "Id": "BreachSplinter" },
      "set": { "Id": "LocalExileDivinePopup", "__col1": "Art/2DArt/UIImages/InGame/LocalExileDivineOrbPopup", "__col8": "Divine" } }
  ],
  "files": [
    { "path": "Art/UIImages1.txt", "appendLines": [
      "\"Art/2DArt/UIImages/InGame/LocalExileChaosOrbPopup\" \"Art/2DItems/Currency/CurrencyRerollRare.dds\" 0 0 80 80",
      "\"Art/2DArt/UIImages/InGame/LocalExileDivineOrbPopup\" \"Art/2DItems/Currency/CurrencyModValues.dds\" 0 0 80 80"
    ] }
  ]
}
