// The Sentinel Recombinators (ExcitingItems' Recombinators.cs): their client rows applied to one item at a time (as a
// Divine Orb's are; the server's own sentinel_craft window is gone), and a place in the currency tab's spare slots.
{
 "edits": [
  {
   "table": "CurrencyItems",
   "where": {
    "BaseItemTypesKey": {
     "row": {
      "table": "BaseItemTypes",
      "Id": "Metadata/Items/Currency/SentinelCurrencyArmour"
     }
    }
   },
   "set": {
    "CurrencyUseType": 2,
    "Action": "reroll_mod_values",
    "__col14": 100,
