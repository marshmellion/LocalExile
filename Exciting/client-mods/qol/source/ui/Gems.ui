// QoL (in-game panels): Alternate quality gems
<DEFINITIONS>

begin Frame
	id = qol_gems;
	aspect_mode = scaley;
	size = 1000, 200;
	float = centre;
	y = 200;
	visible = true;
	mouse_enabled = true;
	propagate_properties = false;
	background_colour = argb( 236, 14, 12, 10 );
	pixel_border_colour = rgb( 137, 100, 64 );

	begin StackLayout
		id = qol_gems_body;
		auto_size = true, true;
		margin = 18, 12, 18, 14;
		float = centre;

		begin Frame
			id = qol_gems_title_bar;
			size = 964, 40;

			begin Label
				id = title_label;
				location = 0, 0;
				size = 916, 40;
				auto_size = false;
				text_align = MiddleLeft;
				font = Fonts.LargeSC;
				foreground_colour = rgb( 227, 194, 146 );
				outline_colour = rgb( 0, 0, 0 );
				text = "Alternate quality gems";
			end

			begin BasicButton
				id = close_button;
				location = 924, 0;
				size = 40, 40;
				mouse_enabled = true;
				background = "Art/2DArt/UIImages/Common/ButtonCloseNormal", stretch;
			end
		end

