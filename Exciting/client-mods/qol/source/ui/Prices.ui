// QoL (in-game panels): price lines beside the character
<DEFINITIONS>

begin Frame
	id = qol_prices;
	aspect_mode = scaley;
	size = 760, 40;
	float = centre;
	y = 520;
	visible = true;
	mouse_enabled = false;
	propagate_properties = false;

	begin StackLayout
		id = qol_prices_rows;
		auto_size = true, true;
		float = centre;

		begin Label
			id = line_0;
			size = 760, 32;
			auto_size = false;
			text_align = MiddleCentre;
			font = Fonts.LargeSC;
