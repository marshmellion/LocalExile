		begin Frame
			id = row_frame_6;
			size = 724, 36;
			begin Button
				id = row_6;
				size = 724, 34;
				text = "-";
			end
		end
		begin Frame
			id = row_frame_7;
			size = 724, 36;
			begin Button
				id = row_7;
				size = 724, 34;
				text = "-";
