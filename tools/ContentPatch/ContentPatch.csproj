<Project Sdk="Microsoft.NET.Sdk">

  <!-- LocalExile content patcher: the play setup's client-data half of the modding API (tools/ContentPatch/Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LocalExile.ContentPatch</RootNamespace>
    <AssemblyName>ContentPatch</AssemblyName>
  </PropertyGroup>

  <!-- test/: fixture builders and checks run by hand in a scratch folder (REFERENCE.md "Testing"), not part of the tool. -->
  <ItemGroup>
    <Compile Remove="test/**" />
    <!-- The extractor's ooz-wasm decoder (Oodle.cs): kept in one place, main's. -->
    <Compile Include="..\..\Tools\PoEDataExtractor\NodeOodleDecoder.cs" Link="NodeOodleDecoder.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameServer.Data\GameServer.Data.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Storage\GameServer.Storage.csproj" />
  </ItemGroup>

</Project>
